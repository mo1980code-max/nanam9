  draft
  pending_review
  published
  archived
  blocked

  @@map("game_status")
}

enum GameKind {
  iframe
  html5_zip
  unity_webgl
  embed_html
  external

  @@map("game_kind")
}

enum GameOrientation {
  any
  portrait
  landscape

  @@map("game_orientation")
}

enum AgeRating {
