  active
  banned
  deleted

  @@map("user_status")
}

enum OAuthProvider {
  google
  facebook
  discord
  apple
  github

  @@map("oauth_provider")
}

enum SessionKind {
  refresh
  api_token
  magic_link

  @@map("session_kind")
}

enum TagScope {
  game
  blog

  @@map("tag_scope")
}

enum AssetKind {
  thumbnail
  banner
  screenshot
  icon
  package
  video

  @@map("asset_kind")
}

enum CommentStatus {
  pending
  visible
  hidden
  spam
  deleted

  @@map("comment_status")
}

enum TargetKind {
