     "type": "int",
     "null": true,
     "fk": "game_licenses.id"
    },
    "verdict": {
     "type": "string",
     "size": 16
    },
    "mode": {
     "type": "string",
     "size": 8,
     "default": "dynamic"
    },
    "rules_version": {
     "type": "int",
     "default": 0
    },
    "reasons": {
     "type": "text",
     "null": true
