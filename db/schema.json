    }
   },
   "indexes": [
    [
     "game_id",
     "audited_at"
    ],
    [
     "verdict"
    ],
    [
     "rules_version"
    ]
   ],
   "note": "append-only ledger: every audit decision is kept, because 'we checked on date X against rules vN' is the only defensible answer to a takedown notice. license_id is nullable + ON DELETE SET NULL so deleting a licence row cannot erase the fact that it was audited."
  },
