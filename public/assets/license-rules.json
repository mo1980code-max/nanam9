{
  "_note": [
    "Single source of truth for licence policy. Nawras\\Licensing\\LicensePolicy loads this file",
    "and tools/gen_license_rules.py copies it verbatim into public/assets/license-rules.json, so",
    "the PHP runtime and the static export decide with the SAME bytes — no second list to drift.",
    "A licence type that is not in `types` is refused outright (unknown_license_type); a licence",
    "row that is missing evidence its type demands is refused too. Adding a rule here is the only",
    "supported way to change policy: tools/verify_php.py fails the build if LicensePolicy.php",
    "mentions a single licence type by name."
  ],
  "version": 1,
  "modes": [
    "dynamic",
    "export"
  ],
  "statuses": {
    "active": {
      "servable": true,
      "blocking": false,
      "label_ar": "ساري",
      "label_en": "Active"
    },
    "pending": {
      "servable": false,
      "blocking": false,
      "label_ar": "قيد التحقق",
      "label_en": "Pending review"
    },
    "expired": {
      "servable": false,
      "blocking": false,
      "label_ar": "منتهي",
      "label_en": "Expired"
    },
    "revoked": {
      "servable": false,
      "blocking": true,
      "label_ar": "مسحوب",
      "label_en": "Revoked"
    },
    "disputed": {
      "servable": false,
      "blocking": true,
      "label_ar": "متنازَع عليه",
      "label_en": "Disputed"
    }
  },
  "evidence": [
    "commit_sha",
    "license_file",
    "license_sha256",
    "proof_url",
    "invoice_ref",
    "expires_at"
  ],
  "types": {
    "own": {
      "label_ar": "إنتاج داخلي",
