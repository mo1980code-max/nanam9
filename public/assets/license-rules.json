      "label_en": "Paid commercial licence",
      "note_en": "Bought per install: invoice plus a term. Never copied into a redistributed bundle.",
      "attribution_required": false,
      "share_alike": false,
      "copyleft": false,
      "commercial_ok": true,
      "redistribution_ok": false,
      "forbidden": false,
      "needs": {
        "commit_sha": false,
        "license_file": false,
        "license_sha256": false,
        "proof_url": true,
        "invoice_ref": true,
        "expires_at": true
      }
    }
  },
  "formats": {
    "commit_sha": {
      "pattern": "^[0-9a-f]{40}$",
      "length": 40
    },
    "license_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "length": 64
    },
    "proof_url": {
      "schemes": [
        "http://",
        "https://"
      ]
    },
    "expires_at": {
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "length": 10
    }
  },
  "origins": {
    "wildcard_allowed": false,
    "separator": ",",
    "max": 8
  },
  "expiry": {
    "warn_days_before": 30
  },
