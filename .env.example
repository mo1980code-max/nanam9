# ─────────────────────────────────────────────────────────────────────────────
# Voltade — environment template
#
#   cp .env.example .env      (the repo-root .env is read by the API and every CLI)
#
# Every variable below is validated at boot by apps/api/src/config/env.ts. A typo
# is a startup failure that names the variable — never a silent wrong default.
# Values shown here are the development defaults; production notes are inline.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development

# ── API ──────────────────────────────────────────────────────────────────────
API_PORT=4000
API_HOST=0.0.0.0
API_PREFIX=api
# Public origin of the API. Media URLs are resolved against it unless a CDN is set.
API_PUBLIC_URL=http://localhost:4000
# Public origin of the Next.js app (used for CORS, OAuth redirects and emails).
APP_URL=http://localhost:3000
# Extra allowed origins, comma separated. Leave empty in development.
CORS_ORIGINS=
LOG_LEVEL=log
# Behind Cloudflare/nginx: keep 1 so client IPs and rate-limit buckets are real.
TRUST_PROXY=1

# ── Database (PostgreSQL 16+) ────────────────────────────────────────────────
# Local development without installing PostgreSQL:  npm run db:up   (PGlite on :5433)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/postgres
# docker compose up -d db  →  postgres://voltade:voltade@localhost:5432/voltade
DATABASE_POOL_MAX=10
# Run pending migrations at boot. Keep 0 in production and migrate in the deploy step.
DATABASE_MIGRATE_ON_BOOT=0

# ── Sessions / tokens ────────────────────────────────────────────────────────
# REQUIRED in production, >= 16 chars. Generate:  openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_SECONDS=2592000
# Set the cookie domain only when the API and web app share a parent domain.
COOKIE_DOMAIN=
# Must be 1 in production (cookies are then refused over plain HTTP).
COOKIE_SECURE=0
CSRF_ENABLED=1

# ── Redis (rate limits, cache, BullMQ queues) ────────────────────────────────
# Optional: without it, rate limits and cache are per-process and queues are off.
REDIS_URL=
QUEUE_PREFIX=voltade

# ── Object storage ───────────────────────────────────────────────────────────
# local  → files are written to STORAGE_LOCAL_DIR and served at STORAGE_PUBLIC_BASE
# s3     → Cloudflare R2, MinIO or AWS S3 (set the three credentials below)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=storage/app
STORAGE_PUBLIC_BASE=/media
# S3_ENDPOINT is required for R2/MinIO (and forces path-style addressing).
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# CDN base in front of the bucket, e.g. https://cdn.voltade.example
S3_CDN_BASE=
S3_FORCE_PATH_STYLE=1

# ── Search ───────────────────────────────────────────────────────────────────
# database   → PostgreSQL full-text search (works everywhere, no extra service)
# meilisearch→ instant typo-tolerant search; set MEILI_HOST to enable
SEARCH_DRIVER=database
MEILI_HOST=
MEILI_API_KEY=
MEILI_INDEX=games

# ── OAuth (Google / Facebook / Discord) ──────────────────────────────────────
# A provider is enabled only when BOTH its id and secret are present.
OAUTH_GOOGLE_ID=
OAUTH_GOOGLE_SECRET=
OAUTH_FACEBOOK_ID=
OAUTH_FACEBOOK_SECRET=
OAUTH_DISCORD_ID=
OAUTH_DISCORD_SECRET=
# Redirects are built as {OAUTH_REDIRECT_BASE}/api/auth/oauth/{provider}/callback
OAUTH_REDIRECT_BASE=

# ── Billing ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_MODE=sandbox

# ── Background jobs ──────────────────────────────────────────────────────────
# Provider import (GameMonetize / GameDistribution) and the daily stats rollup.
# Keep 0 unless exactly ONE process should run the schedules.
IMPORT_CRON_ENABLED=0
IMPORT_CRON=15 * * * *
ROLLUP_CRON=5 0 * * *

# ── Seeding ──────────────────────────────────────────────────────────────────
# Password for the seeded super-admin. If unset, one is generated and printed once.
SEED_ADMIN_PASSWORD=
# 0 seeds settings, RBAC, themes and pages only (no demo games/blog/comments).
SEED_DEMO_CONTENT=1
